# ==============================================================================
# Google TTS MCP Environment Variables Template
# ==============================================================================
# Copy this file to .env and set your Google AI Studio / Gemini API key.

# Single or multiple comma-separated Google Gemini API Key(s) for load balancing / failover
# Get free API keys at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Alternatively, specify multiple keys separated by commas (Load Balancing & Auto-Failover):
# GEMINI_API_KEYS="key_1,key_2,key_3"

# Alternative environment variable name for Google API Key
# GOOGLE_API_KEY="your_google_api_key_here"

